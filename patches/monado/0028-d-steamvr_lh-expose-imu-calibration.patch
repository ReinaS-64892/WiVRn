From: OpenAI Codex <codex@openai.com>
Subject: [PATCH] d/steamvr_lh: expose live receiver calibration through libmonado

Export the receiver and the exact head-from-xdev-grip pose offset. Query live
metadata under the device property mutex so pairing changes do not reuse a
cached receiver. The optional companion API allows QuestLHSync to align raw
receiver IMU samples with poses without guessing grip coordinate systems.

diff --git a/src/xrt/drivers/steamvr_lh/device.cpp b/src/xrt/drivers/steamvr_lh/device.cpp
--- a/src/xrt/drivers/steamvr_lh/device.cpp
+++ b/src/xrt/drivers/steamvr_lh/device.cpp
@@ -386,6 +386,36 @@
 	this->supported.brightness_control = true;
 
 	this->xrt_device::update_inputs = u_device_noop_update_inputs;
+	this->xrt_device::get_lighthouse_calibration = [](xrt_device *xdev, char *receiver,
+	                                                xrt_pose *head_from_pose) -> bool {
+		auto *dev = static_cast<Device *>(xdev);
+		std::lock_guard lock(dev->ctx->devices_mut);
+		// xdev selects the first grip pose. Export its exact static offset, not
+		// an assumption about tracker or controller model coordinates.
+		if (dev->recording_class != vr::TrackedDeviceClass_Controller &&
+		    dev->recording_class != vr::TrackedDeviceClass_GenericTracker)
+			return false;
+		if (!dev->input_class || dev->input_class->poses.empty())
+			return false;
+		const auto pose = dev->input_class->poses.front();
+		switch (pose) {
+		case XRT_INPUT_VIVE_GRIP_POSE:
+		case XRT_INPUT_INDEX_GRIP_POSE:
+		case XRT_INPUT_GENERIC_TRACKER_POSE:
+		case XRT_INPUT_VIVE_TRACKER_GRIP_POSE: break;
+		default: return false; // xdev must agree on which pose was selected
+		}
+		auto it = dev->properties.find(vr::Prop_ConnectedWirelessDongle_String);
+		if (it == dev->properties.end() || it->second.tag != vr::k_unStringPropertyTag)
+			return false;
+		const auto &buffer = it->second.buffer;
+		const size_t n = std::min(buffer.size(), size_t(XRT_DEVICE_NAME_LEN - 1));
+		std::memcpy(receiver, buffer.data(), n);
+		receiver[n] = '\0';
+		*head_from_pose = XRT_POSE_IDENTITY;
+		vive_poses_get_pose_offset(dev->input_class->name, dev->device_type, pose, head_from_pose);
+		return receiver[0] != '\0';
+	};
 #define SETUP_MEMBER_FUNC(name) this->xrt_device::name = &device_bouncer<Device, &Device::name>
 	SETUP_MEMBER_FUNC(get_tracked_pose);
 	SETUP_MEMBER_FUNC(get_battery_status);
