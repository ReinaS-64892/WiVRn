+void
+calibration_metadata_test()
+{
+	auto context = Context::create("/nonexistent-lh-test", "/nonexistent-lh-test", {});
+	TestDevice device(DeviceBuilder{context, nullptr, "LHR-test", "/nonexistent-lh-test",
+	                                vr::TrackedDeviceClass_GenericTracker});
+	char receiver[XRT_DEVICE_NAME_LEN]{};
+	xrt_pose offset{};
+	CHECK(!device.get_lighthouse_calibration(&device, receiver, &offset));
+	const InputClass tracker{XRT_DEVICE_VIVE_TRACKER, {XRT_INPUT_GENERIC_TRACKER_POSE}, {}};
+	device.calibration_profile(&tracker);
+	device.device_type = XRT_DEVICE_TYPE_GENERIC_TRACKER;
+	CHECK(!device.get_lighthouse_calibration(&device, receiver, &offset));
+	auto write = [&](const char *serial) {
+		vr::PropertyWrite_t prop{};
+		prop.prop = vr::Prop_ConnectedWirelessDongle_String;
+		prop.writeType = vr::PropertyWrite_Set;
+		prop.unTag = vr::k_unStringPropertyTag;
+		prop.pvBuffer = const_cast<char *>(serial);
+		prop.unBufferSize = std::strlen(serial) + 1;
+		std::lock_guard lock(context->devices_mut);
+		device.handle_properties(&prop, 1);
+	};
+	write("receiver-A");
+	CHECK(device.get_lighthouse_calibration(&device, receiver, &offset));
+	CHECK(std::strcmp(receiver, "receiver-A") == 0);
+	write("receiver-B");
+	CHECK(device.get_lighthouse_calibration(&device, receiver, &offset));
+	CHECK(std::strcmp(receiver, "receiver-B") == 0);
+	// A real nonidentity grip offset must be supplied for IMU frame conversion.
+	const InputClass index{XRT_DEVICE_INDEX_CONTROLLER, {XRT_INPUT_INDEX_GRIP_POSE}, {}};
+	device.calibration_profile(&index);
+	device.device_type = XRT_DEVICE_TYPE_LEFT_HAND_CONTROLLER;
+	CHECK(device.get_lighthouse_calibration(&device, receiver, &offset));
+	CHECK(std::abs(offset.position.x) + std::abs(offset.position.y) + std::abs(offset.position.z) > .001f);
+	context->stop_frame_thread();
+}
