 mnd_result_t
+mnd_root_get_lighthouse_calibration(mnd_root_t *root, uint32_t device_index,
+                                    const char **out_receiver, mnd_pose_t *out_head_from_pose)
+{
+	CHECK_NOT_NULL(root);
+	CHECK_NOT_NULL(out_receiver);
+	CHECK_NOT_NULL(out_head_from_pose);
+	CHECK_DEVICE_INDEX(device_index);
+	*out_receiver = NULL;
+	struct ipc_device_info *info = &root->device_infos[device_index];
+	const uint32_t id = root->device_list.devices[device_index].id;
+	if (ipc_call_device_get_info_no_arrays(&root->ipc_c, id, info) != XRT_SUCCESS)
+		return MND_ERROR_OPERATION_FAILED;
+	if (!info->lighthouse_calibration)
+		return MND_ERROR_INVALID_OPERATION;
+	*out_receiver = info->lighthouse_receiver;
+	memcpy(out_head_from_pose, &info->lighthouse_head_from_pose, sizeof(*out_head_from_pose));
+	return MND_SUCCESS;
+}
