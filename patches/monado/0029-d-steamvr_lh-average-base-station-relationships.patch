diff --git a/tests/tests_steamvr_lh_relationship_driver.cpp b/tests/tests_steamvr_lh_relationship_driver.cpp
new file mode 100644
--- /dev/null
+++ b/tests/tests_steamvr_lh_relationship_driver.cpp
@@ -0,0 +1,12 @@
+// Copyright 2026, OpenAI
+// SPDX-License-Identifier: BSL-1.0
+// Small ELF fixture with the Linux Lighthouse relationship ABI and log marker.
+#include <cstdint>
+struct Rel7 { float f[7]; };
+static const char moving[] = "Moving base %08X %.0fmm and %.1f deg because of relationship with %08X";
+extern "C" __attribute__((noinline)) void relationship(void *state, uint32_t, uint32_t, Rel7 rel, float) {
+  asm volatile("" : : "r"(moving) : "memory");
+  float *out = static_cast<float *>(state);
+  out[0] = rel.f[0]; // fixed [rbp+0x10] read, as used by the real driver's ABI
+  for (int i = 1; i < 7; ++i) out[i] = rel.f[i];
+}
diff --git a/tests/tests_steamvr_lh_relationships.cpp b/tests/tests_steamvr_lh_relationships.cpp
new file mode 100644
--- /dev/null
+++ b/tests/tests_steamvr_lh_relationships.cpp
@@ -0,0 +1,69 @@
+// Copyright 2026, OpenAI
+// SPDX-License-Identifier: BSL-1.0
+#include "interfaces/context.hpp"
+#include <cmath>
+#include <cstdlib>
+#include <dlfcn.h>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <stdexcept>
+#include <unistd.h>
+
+struct Rel7 { float f[7]; };
+static void check(bool ok) { if (!ok) throw std::runtime_error("relationship averaging assertion failed"); }
+int main(int argc, char **argv)
+{
+	check(argc == 3);
+	void *driver = dlopen(argv[1], RTLD_NOW | RTLD_LOCAL);
+	if (!driver) throw std::runtime_error(dlerror());
+	const bool enabled = std::string(argv[2]) != "off";
+	char path[] = "/tmp/monado-relationships-XXXXXX";
+	check(mkdtemp(path));
+	const auto state = std::filesystem::path(path) / "config/lighthouse/monado-relations.json";
+	auto context = Context::create(path, path, {});
+	check(bool(context));
+	check(bool(context->relations) == enabled);
+	if (std::string(argv[2]) == "probe") {
+		check(context->relations->hooked());
+		context.reset();
+		dlclose(driver);
+		std::filesystem::remove_all(path);
+		return 0;
+	}
+	auto relationship = reinterpret_cast<void (*)(void *, uint32_t, uint32_t, Rel7, float)>(dlsym(driver, "relationship"));
+	check(relationship);
+	auto submit = [&](float x, bool inverse = false, bool antipodal = false) {
+		float out[7]{};
+		Rel7 rel{{0, 0, 0, antipodal ? -1.f : 1.f, inverse ? -x : x, 0, 0}};
+		relationship(out, inverse ? 2 : 1, inverse ? 1 : 2, rel, 0);
+		return inverse ? -out[4] : out[4];
+	};
+	check(std::abs(submit(2) - 2) < 1e-5f);
+	if (!enabled) {
+		check(std::abs(submit(2.02f) - 2.02f) < 1e-5f);
+		context.reset();
+		check(!std::filesystem::exists(state));
+	} else {
+		check(context->relations->hooked());
+		check(std::abs(submit(2.02f, true, true) - 2.01f) < 1e-4f);
+		check(std::abs(submit(5) - 2.01f) < 1e-4f);
+		check(std::abs(submit(5.01f) - 5.005f) < 1e-4f);
+		context.reset();
+		check(std::filesystem::exists(state));
+		context = Context::create(path, path, {});
+		check(context && context->relations && context->relations->hooked());
+		check(std::abs(submit(5.02f) - 5.01f) < 1e-4f);
+		context.reset();
+		check(std::abs(submit(7) - 7) < 1e-5f);
+		// Corrupt persisted poses must never feed NaNs/zero quaternions into the driver.
+		std::ofstream(state) << R"({"pairs":{"LHB-00000001 LHB-00000002":[[0,0,0,0,2,0,0]]}})";
+		context = Context::create(path, path, {});
+		check(context && context->relations && context->relations->hooked());
+		check(std::abs(submit(3) - 3) < 1e-5f);
+		context.reset();
+	}
+	dlclose(driver);
+	std::filesystem::remove_all(path);
+	std::cout << "Native Lighthouse relationship averaging " << (enabled ? "enabled" : "disabled") << " passed\n";
+}
