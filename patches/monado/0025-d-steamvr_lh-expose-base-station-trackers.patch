 }
 
+void
+Context::publish_tracking_references_locked(struct xrt_system_devices *system)
+{
+	if (!debug_get_bool_option_lh_expose_base_stations())
+		return;
+	for (auto &reference : references) {
+		if (!reference || !reference->activated || reference->published)
+			continue;
+		if (system->static_xdev_count >= XRT_SYSTEM_MAX_DEVICES) {
+			CTX_WARN("Out of device slots, not exposing base station %s", reference->serial);
+			continue;
+		}
+		auto *tracker = reference->create_tracker(shared_from_this());
+		if (system == xsysd) {
+			append_to_xsysd_locked(tracker);
+		} else {
+			// Initial discovery: the builder creates spaces after we return.
+			system->static_xdevs[system->static_xdev_count++] = tracker;
+		}
+		reference->published = true;
+	}
+}
