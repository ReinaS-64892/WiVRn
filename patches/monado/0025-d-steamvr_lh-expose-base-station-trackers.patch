+namespace {
+// Context owns the callback target; the exported xdev owns Context. Keeping
+// these objects separate avoids both a reference cycle and double destruction.
+struct BaseStationTracker : xrt_device
+{
+	std::shared_ptr<Context> owner;
+	TrackingReferenceDevice *reference;
+	xrt_input pose_input{};
+
+	BaseStationTracker(std::shared_ptr<Context> context, TrackingReferenceDevice *device)
+	    : xrt_device{}, owner(std::move(context)), reference(device)
+	{
+		u_device_id_assign(this);
+		name = XRT_DEVICE_VIVE_TRACKER;
+		device_type = XRT_DEVICE_TYPE_GENERIC_TRACKER;
+		std::snprintf(str, sizeof(str), "Lighthouse Base Station Tracker");
+		std::snprintf(serial, sizeof(serial), "%s", device->serial);
+		tracking_origin = owner.get();
+		supported.orientation_tracking = supported.position_tracking = true;
+		pose_input.active = true;
+		pose_input.name = XRT_INPUT_GENERIC_TRACKER_POSE;
+		inputs = &pose_input;
+		input_count = 1;
+		update_inputs = u_device_noop_update_inputs;
+		get_tracked_pose = [](xrt_device *xdev, xrt_input_name input, int64_t timestamp,
+		                      xrt_space_relation *out) -> xrt_result_t {
+			if (input != XRT_INPUT_GENERIC_TRACKER_POSE)
+				return XRT_ERROR_INPUT_UNSUPPORTED;
+			auto *self = static_cast<BaseStationTracker *>(xdev);
+			self->reference->get_pose(timestamp, out);
+			return XRT_SUCCESS;
+		};
+		destroy = [](xrt_device *xdev) { delete static_cast<BaseStationTracker *>(xdev); };
+		u_device_populate_function_pointers(this, get_tracked_pose, destroy);
+	}
+};
+} // namespace
+
+xrt_device *
+TrackingReferenceDevice::create_tracker(const std::shared_ptr<Context> &owner)
+{
+	return new BaseStationTracker(owner, this);
+}
