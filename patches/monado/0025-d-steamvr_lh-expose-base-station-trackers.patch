+static void
+exposed_test()
+{
+	Provider provider;
+	Driver first, second;
+	auto context = Context::create("/nonexistent-lh-test", "/nonexistent-lh-test", {&provider});
+	CHECK(context);
+	first.host = second.host = context.get();
+	provider.first = &first;
+	CHECK(context->TrackedDeviceAdded("LHB-12345678", vr::TrackedDeviceClass_TrackingReference, &first));
+	xrt_system_devices system{};
+	{
+		std::lock_guard lock(context->devices_mut);
+		context->publish_tracking_references_locked(&system);
+		context->publish_tracking_references_locked(&system);
+	}
+	CHECK(system.static_xdev_count == 1);
+	auto *station = system.static_xdevs[0];
+	CHECK(std::strcmp(station->serial, "LHB-12345678") == 0);
+	CHECK(station->device_type == XRT_DEVICE_TYPE_GENERIC_TRACKER);
+	CHECK(station->tracking_origin == context.get());
+	CHECK(station->input_count == 1 && station->inputs[0].active);
+	CHECK(station->inputs[0].name == XRT_INPUT_GENERIC_TRACKER_POSE);
+	CHECK(!station->supported.hand_tracking && !station->supported.battery_status);
+	xrt_space_relation pose{};
+	// Station callbacks are sparse: hold the measurement, never predict motion.
+	CHECK(xrt_device_get_tracked_pose(station, XRT_INPUT_GENERIC_TRACKER_POSE,
+	                                 os_monotonic_get_ns() + 60000000000LL, &pose) == XRT_SUCCESS);
+	CHECK(pose.relation_flags & XRT_SPACE_RELATION_POSITION_TRACKED_BIT);
+	CHECK(std::abs(pose.pose.position.x - 10) < 1e-4f);
+	CHECK(std::abs(pose.pose.position.y - 21) < 1e-4f);
+	CHECK(std::abs(pose.pose.position.z - 28) < 1e-4f);
+	CHECK(xrt_device_get_tracked_pose(station, XRT_INPUT_GENERIC_HEAD_POSE,
+	                                 os_monotonic_get_ns(), &pose) == XRT_ERROR_INPUT_UNSUPPORTED);
+	vr::DriverPose_t update{};
+	update.qRotation.w = update.qWorldFromDriverRotation.w = update.qDriverFromHeadRotation.w = 1;
+	context->TrackedDevicePoseUpdated(first.index, update, sizeof(update));
+	xrt_device_get_tracked_pose(station, XRT_INPUT_GENERIC_TRACKER_POSE, os_monotonic_get_ns(), &pose);
+	CHECK(pose.relation_flags == 0);
+	update.poseIsValid = update.deviceIsConnected = true;
+	update.result = vr::TrackingResult_Running_OK;
+	update.vecPosition[0] = 4;
+	update.vecVelocity[0] = 10; // even spurious velocity must not move a station
+	context->TrackedDevicePoseUpdated(first.index, update, sizeof(update));
+	xrt_device_get_tracked_pose(station, XRT_INPUT_GENERIC_TRACKER_POSE,
+	                            os_monotonic_get_ns() + 60000000000LL, &pose);
+	CHECK(pose.relation_flags & XRT_SPACE_RELATION_POSITION_TRACKED_BIT);
+	CHECK(std::abs(pose.pose.position.x - 4) < 1e-4f);
+	// Hotplug uses the same append callback as controllers, before publication.
+	unsigned additions = 0;
+	{
+		std::lock_guard lock(context->devices_mut);
+		context->in_setup = false;
+		context->xsysd = &system;
+		context->device_added_ud = &additions;
+		context->device_added_cb = [](xrt_device *dev, void *ud) {
+			CHECK(dev->inputs[0].name == XRT_INPUT_GENERIC_TRACKER_POSE);
+			++*static_cast<unsigned *>(ud);
+		};
+	}
+	CHECK(context->TrackedDeviceAdded("LHB-ABCDEF00", vr::TrackedDeviceClass_TrackingReference, &second));
+	CHECK(system.static_xdev_count == 2 && additions == 1);
+	CHECK(system.static_xdevs[1]->tracking_origin == station->tracking_origin);
+	xrt_system_roles roles{};
+	CHECK(context->get_roles(&system, &roles) == XRT_SUCCESS);
+	CHECK(roles.left == XRT_DEVICE_ROLE_UNASSIGNED && roles.right == XRT_DEVICE_ROLE_UNASSIGNED);
+	context->stop_frame_thread();
+	std::weak_ptr<Context> weak = context;
+	context.reset();
+	CHECK(!weak.expired());
+	xrt_device_destroy(&system.static_xdevs[0]);
+	CHECK(first.deactivations == 0 && second.deactivations == 0);
+	xrt_device_destroy(&system.static_xdevs[1]);
+	CHECK(weak.expired() && provider.cleaned);
+	CHECK(first.deactivations == 1 && second.deactivations == 1);
+}
