index 000000000..03c0726a8
--- /dev/null
+++ b/tests/tests_flugelkranz_rotation.cpp
@@ -0,0 +1,189 @@
+// Copyright 2026, OpenAI.
+// SPDX-License-Identifier: BSL-1.0
+#include "catch_amalgamated.hpp"
+#include "b_space_overseer.h"
+#include "xrt/xrt_device.h"
+#include "xrt/xrt_session.h"
+#include "xrt/xrt_tracking.h"
+#include "math/m_api.h"
+#include <cmath>
+#include <limits>
+
+namespace {
+xrt_quat
+turn(float x, float y, float z, float angle)
+{
+	xrt_vec3 axis{x, y, z};
+	xrt_quat q;
+	math_quat_from_angle_vector(angle, &axis, &q);
+	return q;
+}
+xrt_quat
+mul(xrt_quat a, xrt_quat b)
+{
+	xrt_quat q;
+	math_quat_rotate(&a, &b, &q);
+	return q;
+}
+void
+near(xrt_quat a, xrt_quat b)
+{
+	float dot = a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w;
+	CHECK(std::abs(dot) == Catch::Approx(1).margin(0.00001));
+}
+struct Device : xrt_device
+{
+	xrt_tracking_origin origin{};
+	xrt_space_relation relation = XRT_SPACE_RELATION_ZERO;
+	Device(uint64_t number, xrt_quat calibration) : xrt_device{}
+	{
+		id.val = number;
+		device_type = XRT_DEVICE_TYPE_GENERIC_TRACKER;
+		origin.initial_offset = {calibration, {2, 1, -3}};
+		origin.type = XRT_TRACKING_TYPE_OTHER;
+		tracking_origin = &origin;
+		relation.pose = {turn(1, 0, 0, .3f), {.2f, .1f, .4f}};
+		relation.relation_flags = (xrt_space_relation_flags)(XRT_SPACE_RELATION_ORIENTATION_VALID_BIT |
+		                                                     XRT_SPACE_RELATION_POSITION_VALID_BIT |
+		                                                     XRT_SPACE_RELATION_ORIENTATION_TRACKED_BIT |
+		                                                     XRT_SPACE_RELATION_POSITION_TRACKED_BIT |
+		                                                     XRT_SPACE_RELATION_ANGULAR_VELOCITY_VALID_BIT);
+		get_tracked_pose = [](xrt_device *d, xrt_input_name, int64_t, xrt_space_relation *out) {
+			*out = static_cast<Device *>(d)->relation;
+			return XRT_SUCCESS;
+		};
+	}
+};
+struct World
+{
+	Device toe{1, turn(0, 0, 1, .7f)}, other{2, turn(0, 0, 1, .7f)};
+	xrt_session_event_sink sink{};
+	b_space_overseer *b;
+	xrt_space_overseer *xso;
+	xrt_space *pose = nullptr;
+	xrt_pose identity = XRT_POSE_IDENTITY;
+	World()
+	{
+		sink.push_event = [](xrt_session_event_sink *, const xrt_session_event *) { return XRT_SUCCESS; };
+		b = b_space_overseer_create(&sink);
+		xso = reinterpret_cast<xrt_space_overseer *>(b);
+		xrt_device *devices[]{&toe, &other};
+		b_space_overseer_legacy_setup(b, devices, 2, nullptr, &identity, false, false);
+		REQUIRE(b_space_overseer_create_pose_space(b, &toe, XRT_INPUT_GENERIC_TRACKER_POSE, &pose) ==
+		        XRT_SUCCESS);
+	}
+	~World()
+	{
+		xrt_space_reference(&pose, nullptr);
+		xrt_space_overseer_destroy(&xso);
+	}
+	xrt_space_relation
+	locate(xrt_space *base = nullptr)
+	{
+		xrt_space_relation result{};
+		REQUIRE(xrt_space_overseer_locate_space(xso, base ? base : xso->semantic.stage, &identity, 100, pose,
+		                                        &identity, &result) == XRT_SUCCESS);
+		return result;
+	}
+	xrt_result_t
+	apply(const void *owner, xrt_quat q, xrt_pose stage = XRT_POSE_IDENTITY)
+	{
+		xrt_device *devices[]{&toe};
+		return xso->flugelkranz_apply(xso, owner, &stage, 1, devices, &q);
+	}
+};
+} // namespace
+TEST_CASE("FlugelKranz orientation offsets preserve position and physical ankle motion", "[flugelkranz]")
+{
+	World w;
+	const auto before = w.locate();
+	auto yaw = turn(0, 1, 0, .6f);
+	REQUIRE(w.apply(&w, yaw) == XRT_SUCCESS);
+	auto after = w.locate();
+	near(after.pose.orientation, mul(yaw, before.pose.orientation));
+	CHECK(after.pose.position.x == Catch::Approx(before.pose.position.x));
+	CHECK(after.pose.position.y == Catch::Approx(before.pose.position.y));
+	CHECK(after.pose.position.z == Catch::Approx(before.pose.position.z));
+	CHECK((after.relation_flags & XRT_SPACE_RELATION_ANGULAR_VELOCITY_VALID_BIT) == 0);
+	// Physical ankle changes survive the root-axis correction under a tilted tracking origin.
+	w.toe.relation.pose.orientation = turn(1, 0, 0, .8f);
+	near(w.locate().pose.orientation,
+	     mul(yaw, mul(w.toe.origin.initial_offset.orientation, w.toe.relation.pose.orientation)));
+	// Raw driver poses remain available and unmodified.
+	xrt_space_relation raw{};
+	xrt_device_get_tracked_pose(&w.toe, XRT_INPUT_GENERIC_TRACKER_POSE, 100, &raw);
+	near(raw.pose.orientation, w.toe.relation.pose.orientation);
+	// Other devices are not affected.
+	xrt_space *other = nullptr;
+	REQUIRE(b_space_overseer_create_pose_space(w.b, &w.other, XRT_INPUT_GENERIC_TRACKER_POSE, &other) ==
+	        XRT_SUCCESS);
+	REQUIRE(xrt_space_overseer_locate_space(w.xso, w.xso->semantic.root, &w.identity, 100, other, &w.identity,
+	                                        &raw) == XRT_SUCCESS);
+	near(raw.pose.orientation, mul(w.other.origin.initial_offset.orientation, w.other.relation.pose.orientation));
+	xrt_space_reference(&other, nullptr);
+}
+TEST_CASE("FlugelKranz batch stage update and inverse and multi-space queries agree", "[flugelkranz]")
+{
+	World w;
+	auto before = w.locate();
+	xrt_pose stage{turn(0, 1, 0, .4f), {1, 0, 2}};
+	REQUIRE(w.apply(&w, stage.orientation, stage) == XRT_SUCCESS);
+	near(w.locate().pose.orientation, before.pose.orientation); // STAGE inverse cancels correction.
+	xrt_space_relation inverse{};
+	REQUIRE(xrt_space_overseer_locate_space(w.xso, w.pose, &w.identity, 100, w.xso->semantic.stage, &w.identity,
+	                                        &inverse) == XRT_SUCCESS);
+	xrt_quat expected;
+	math_quat_invert(&before.pose.orientation, &expected);
+	near(inverse.pose.orientation, expected);
+	xrt_space *spaces[]{w.pose, w.pose};
+	xrt_pose offsets[]{w.identity, w.identity};
+	xrt_space_relation results[2]{};
+	REQUIRE(xrt_space_overseer_locate_spaces(w.xso, w.xso->semantic.stage, &w.identity, 100, spaces, 2, offsets,
+	                                         results) == XRT_SUCCESS);
+	near(results[0].pose.orientation, before.pose.orientation);
+	near(results[1].pose.orientation, before.pose.orientation);
+}
+TEST_CASE("FlugelKranz rejects invalid batches without changing stage or corrections", "[flugelkranz]")
+{
+	World w;
+	REQUIRE(w.apply(&w, turn(0, 1, 0, .2f)) == XRT_SUCCESS);
+	auto before = w.locate();
+	xrt_pose moved{turn(0, 1, 0, .8f), {10, 20, 30}};
+	CHECK(w.apply(&w, {0, 0, 0, 0}, moved) != XRT_SUCCESS);
+	CHECK(w.apply(&w, {0, std::numeric_limits<float>::quiet_NaN(), 0, 1}, moved) != XRT_SUCCESS);
+	w.toe.device_type = XRT_DEVICE_TYPE_HMD;
+	CHECK(w.apply(&w, turn(0, 1, 0, .3f), moved) != XRT_SUCCESS);
+	w.toe.device_type = XRT_DEVICE_TYPE_GENERIC_TRACKER;
+	xrt_device *duplicates[]{&w.toe, &w.toe};
+	xrt_quat quats[]{turn(0, 1, 0, .1f), turn(0, 1, 0, .2f)};
+	CHECK(w.xso->flugelkranz_apply(w.xso, &w, &moved, 2, duplicates, quats) != XRT_SUCCESS);
+	near(w.locate().pose.orientation, before.pose.orientation);
+	auto position = w.locate().pose.position;
+	CHECK(position.x == Catch::Approx(before.pose.position.x));
+	CHECK(position.y == Catch::Approx(before.pose.position.y));
+	CHECK(position.z == Catch::Approx(before.pose.position.z));
+}
+TEST_CASE("FlugelKranz owner cleanup replacement and device removal clear offsets", "[flugelkranz]")
+{
+	World w;
+	int other_owner = 0;
+	auto raw = w.locate();
+	auto q = turn(0, 1, 0, .5f);
+	REQUIRE(w.apply(&w, q) == XRT_SUCCESS);
+	CHECK(w.apply(&other_owner, q) != XRT_SUCCESS);
+	// Unrelated client disconnect must not clear the owner's correction.
+	REQUIRE(w.xso->flugelkranz_apply(w.xso, &other_owner, nullptr, 0, nullptr, nullptr) == XRT_SUCCESS);
+	near(w.locate().pose.orientation, mul(q, raw.pose.orientation));
+	REQUIRE(w.xso->flugelkranz_apply(w.xso, &w, nullptr, 0, nullptr, nullptr) == XRT_SUCCESS);
+	near(w.locate().pose.orientation, raw.pose.orientation);
+	REQUIRE(w.apply(&other_owner, q) == XRT_SUCCESS);
+	REQUIRE(w.xso->flugelkranz_apply(w.xso, &other_owner, &w.identity, 0, nullptr, nullptr) == XRT_SUCCESS);
+	near(w.locate().pose.orientation, raw.pose.orientation);
+	REQUIRE(w.apply(&w, q) == XRT_SUCCESS);
+	REQUIRE(xrt_space_overseer_remove_device(w.xso, &w.toe) == XRT_SUCCESS);
+	REQUIRE(xrt_space_overseer_add_device(w.xso, &w.toe) == XRT_SUCCESS);
+	xrt_space_reference(&w.pose, nullptr);
+	REQUIRE(b_space_overseer_create_pose_space(w.b, &w.toe, XRT_INPUT_GENERIC_TRACKER_POSE, &w.pose) ==
+	        XRT_SUCCESS);
+	near(w.locate().pose.orientation, raw.pose.orientation);
+}
