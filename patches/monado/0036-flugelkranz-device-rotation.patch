From: OpenAI Codex <codex@openai.com>
Subject: [PATCH] libmonado: add private FlugelKranz tracker rotation batches

Refresh device-index snapshots and atomically commit STAGE with root-axis,
orientation-only tracker corrections. Keep driver poses and positions raw,
clear corrections on owner disconnect and device removal, and validate
complete batches before changing state. Cover composition, inverse/batched
queries, validation and cleanup with native regression tests.
---
diff --git a/src/xrt/base/b_space_overseer.c b/src/xrt/base/b_space_overseer.c
index 310b74e2f..076159d75 100644
--- a/src/xrt/base/b_space_overseer.c
+++ b/src/xrt/base/b_space_overseer.c
@@ -108,6 +108,14 @@ struct b_space_overseer
 {
 	struct xrt_space_overseer base;
 
+	const void *flugelkranz_owner;
+	uint32_t flugelkranz_count;
+	struct
+	{
+		struct xrt_device *device;
+		struct xrt_quat rotation;
+	} flugelkranz[32];
+
 	//! Main graph lock.
 	pthread_rwlock_t lock;
 
@@ -384,6 +392,44 @@ hashmap_unreference_tracked_device_items(void *item, void *priv)
  * from a leaf space to a the root space, relations are pushed in the same
  * order.
  */
+static void
+push_then_traverse(struct xrt_relation_chain *xrc, struct u_space *space, int64_t at_timestamp_ns);
+
+/* Caller holds the graph lock. Drivers and raw device IPC remain unmodified.
+ * Convert a root-axis orientation correction into the pose's parent axes.
+ * Left multiplication preserves physical ankle rotation; position is untouched. */
+static void
+flugelkranz_correct(struct u_space *space, int64_t time, struct xrt_space_relation *relation)
+{
+	struct b_space_overseer *uso = space->pose.overseer;
+	if (uso == NULL || !(relation->relation_flags & XRT_SPACE_RELATION_ORIENTATION_VALID_BIT))
+		return;
+	for (uint32_t i = 0; i < uso->flugelkranz_count; i++) {
+		if (uso->flugelkranz[i].device != space->pose.xdev)
+			continue;
+		struct xrt_relation_chain chain = {0};
+		push_then_traverse(&chain, space->next, time);
+		struct xrt_space_relation parent;
+		if (chain.step_count == 0) {
+			parent = (struct xrt_space_relation)XRT_SPACE_RELATION_ZERO;
+			parent.pose.orientation.w = 1;
+		} else {
+			m_relation_chain_resolve(&chain, &parent);
+			if (!(parent.relation_flags & XRT_SPACE_RELATION_ORIENTATION_VALID_BIT))
+				return;
+		}
+		struct xrt_quat inverse, local, temp;
+		math_quat_invert(&parent.pose.orientation, &inverse);
+		math_quat_rotate(&inverse, &uso->flugelkranz[i].rotation, &temp);
+		math_quat_rotate(&temp, &parent.pose.orientation, &local);
+		math_quat_rotate(&local, &relation->pose.orientation, &temp);
+		relation->pose.orientation = temp;
+		/* The caller supplies sampled corrections, without their derivative. */
+		relation->relation_flags &= ~XRT_SPACE_RELATION_ANGULAR_VELOCITY_VALID_BIT;
+		return;
+	}
+}
+
 static void
 push_then_traverse(struct xrt_relation_chain *xrc, struct u_space *space, int64_t at_timestamp_ns)
 {
@@ -398,6 +444,7 @@ push_then_traverse(struct xrt_relation_chain *xrc, struct u_space *space, int64_
 
 		struct xrt_space_relation xsr;
 		xrt_device_get_tracked_pose(space->pose.xdev, space->pose.xname, at_timestamp_ns, &xsr);
+		flugelkranz_correct(space, at_timestamp_ns, &xsr);
 		m_relation_chain_push_relation(xrc, &xsr);
 	} break;
 	case U_SPACE_TYPE_OFFSET: m_relation_chain_push_pose_if_not_identity(xrc, &space->offset.pose); break;
@@ -443,6 +490,7 @@ traverse_then_push_inverse(struct xrt_relation_chain *xrc, struct u_space *space
 
 		struct xrt_space_relation xsr;
 		xrt_device_get_tracked_pose(space->pose.xdev, space->pose.xname, at_timestamp_ns, &xsr);
+		flugelkranz_correct(space, at_timestamp_ns, &xsr);
 		m_relation_chain_push_inverted_relation(xrc, &xsr);
 	} break;
 	case U_SPACE_TYPE_ZOMBIE: assert(false); break; // Handled above.
@@ -1161,9 +1209,9 @@ unlock:
 }
 
 static xrt_result_t
-set_reference_space_offset(struct xrt_space_overseer *xso,
-                           enum xrt_reference_space_type type,
-                           const struct xrt_pose *offset)
+set_reference_space_offset_locked(struct xrt_space_overseer *xso,
+                                  enum xrt_reference_space_type type,
+                                  const struct xrt_pose *offset)
 {
 	if (type == XRT_SPACE_REFERENCE_TYPE_LOCAL_FLOOR) {
 		// LOCAL_FLOOR is calculated from LOCAL and STAGE
@@ -1178,7 +1226,6 @@ set_reference_space_offset(struct xrt_space_overseer *xso,
 
 	xrt_result_t xret = XRT_SUCCESS;
 
-	pthread_rwlock_wrlock(&uso->lock);
 
 	struct u_space *us = get_semantic_space(uso, type);
 	if (!space_is_offset_compatible(us)) {
@@ -1235,10 +1282,81 @@ set_reference_space_offset(struct xrt_space_overseer *xso,
 	}
 
 unlock:
-	pthread_rwlock_unlock(&uso->lock);
 	return xret;
 }
 
+static xrt_result_t
+set_reference_space_offset(struct xrt_space_overseer *xso,
+                           enum xrt_reference_space_type type,
+                           const struct xrt_pose *offset)
+{
+	struct b_space_overseer *uso = b_space_overseer(xso);
+	pthread_rwlock_wrlock(&uso->lock);
+	xrt_result_t ret = set_reference_space_offset_locked(xso, type, offset);
+	pthread_rwlock_unlock(&uso->lock);
+	return ret;
+}
+
+static xrt_result_t
+flugelkranz_apply(struct xrt_space_overseer *xso,
+                  const void *owner,
+                  const struct xrt_pose *stage,
+                  uint32_t count,
+                  struct xrt_device *const *devices,
+                  const struct xrt_quat *rotations)
+{
+	struct b_space_overseer *uso = b_space_overseer(xso);
+	if (count > ARRAY_SIZE(uso->flugelkranz))
+		return XRT_ERROR_INPUT_UNSUPPORTED;
+	pthread_rwlock_wrlock(&uso->lock);
+	xrt_result_t ret = XRT_SUCCESS;
+	if (uso->flugelkranz_owner != NULL && uso->flugelkranz_owner != owner) {
+		ret = stage == NULL ? XRT_SUCCESS : XRT_ERROR_INPUT_UNSUPPORTED;
+		goto out;
+	}
+	for (uint32_t i = 0; i < count; i++) {
+		if (devices[i]->device_type != XRT_DEVICE_TYPE_GENERIC_TRACKER ||
+		    find_xdev_tracked_device_read_locked(uso, devices[i]) == NULL ||
+		    !math_quat_validate_within_1_percent(&rotations[i])) {
+			ret = XRT_ERROR_INPUT_UNSUPPORTED;
+			goto out;
+		}
+		for (uint32_t j = 0; j < i; j++) {
+			if (devices[i] == devices[j]) {
+				ret = XRT_ERROR_INPUT_UNSUPPORTED;
+				goto out;
+			}
+		}
+	}
+	if (stage != NULL) {
+		if (!math_vec3_validate(&stage->position) ||
+		    !math_quat_validate_within_1_percent(&stage->orientation)) {
+			ret = XRT_ERROR_INPUT_UNSUPPORTED;
+			goto out;
+		}
+		if (uso->can_do_local_spaces_recenter ||
+		    !space_is_offset_compatible(get_semantic_space(uso, XRT_SPACE_REFERENCE_TYPE_STAGE)) ||
+		    !space_is_offset_compatible(u_space(xso->semantic.local_floor))) {
+			ret = XRT_ERROR_UNSUPPORTED_SPACE_TYPE;
+			goto out;
+		}
+		struct xrt_pose normalized_stage = *stage;
+		math_quat_normalize(&normalized_stage.orientation);
+		/* Notification failure cannot roll back a committed space update. */
+		set_reference_space_offset_locked(xso, XRT_SPACE_REFERENCE_TYPE_STAGE, &normalized_stage);
+	}
+	uso->flugelkranz_owner = count > 0 ? owner : NULL;
+	uso->flugelkranz_count = count;
+	for (uint32_t i = 0; i < count; i++) {
+		uso->flugelkranz[i].device = devices[i];
+		uso->flugelkranz[i].rotation = rotations[i];
+		math_quat_normalize(&uso->flugelkranz[i].rotation);
+	}
+out:
+	pthread_rwlock_unlock(&uso->lock);
+	return ret;
+}
+
 static xrt_result_t
 add_device(struct xrt_space_overseer *xso, struct xrt_device *xdev)
 {
@@ -1253,6 +1371,13 @@ remove_device(struct xrt_space_overseer *xso, struct xrt_device *xdev)
 	struct b_space_overseer *uso = b_space_overseer(xso);
 
 	pthread_rwlock_wrlock(&uso->lock);
+	for (uint32_t i = 0; i < uso->flugelkranz_count;) {
+		if (uso->flugelkranz[i].device == xdev) {
+			uso->flugelkranz[i] = uso->flugelkranz[--uso->flugelkranz_count];
+		} else {
+			i++;
+		}
+	}
 
 	struct b_tracked_device *btd = find_xdev_tracked_device_read_locked(uso, xdev);
 	if (btd != NULL) {
@@ -1379,6 +1504,7 @@ b_space_overseer_create(struct xrt_session_event_sink *broadcast)
 	uso->base.set_reference_space_offset = set_reference_space_offset;
 	uso->base.add_device = add_device;
 	uso->base.remove_device = remove_device;
+	uso->base.flugelkranz_apply = flugelkranz_apply;
 	uso->base.attach_device = attach_device;
 	uso->base.destroy = destroy;
 	uso->broadcast = broadcast;
diff --git a/src/xrt/include/xrt/xrt_space.h b/src/xrt/include/xrt/xrt_space.h
index fd6b46bea..e00552364 100644
--- a/src/xrt/include/xrt/xrt_space.h
+++ b/src/xrt/include/xrt/xrt_space.h
@@ -382,6 +382,16 @@ struct xrt_space_overseer
 	 *
 	 * @param xso The space overseer.
 	 */
+	/* Private WiVRn/FlugelKranz extension. Complete replacement, in root axes.
+	 * A non-NULL stage is committed atomically with the orientation corrections.
+	 * NULL stage/count zero releases corrections owned by this IPC connection. */
+	xrt_result_t (*flugelkranz_apply)(struct xrt_space_overseer *xso,
+	                                  const void *owner,
+	                                  const struct xrt_pose *stage,
+	                                  uint32_t count,
+	                                  struct xrt_device *const *devices,
+	                                  const struct xrt_quat *rotations);
+
 	void (*destroy)(struct xrt_space_overseer *xs);
 };
 
diff --git a/src/xrt/ipc/server/ipc_server_handler.c b/src/xrt/ipc/server/ipc_server_handler.c
index 9f298ce00..dcb61d3d3 100644
--- a/src/xrt/ipc/server/ipc_server_handler.c
+++ b/src/xrt/ipc/server/ipc_server_handler.c
@@ -2874,3 +2874,19 @@ ipc_handle_future_destroy(volatile struct ipc_client_state *ics, uint32_t future
 {
 	return release_future(ics, future_id);
 }
+
+/* The libmonado snapshot's indices have already been translated to IPC IDs. */
+xrt_result_t
+ipc_handle_space_flugelkranz_apply(volatile struct ipc_client_state *ics,
+                                   const struct xrt_pose *stage,
+                                   const struct ipc_flugelkranz_update *update)
+{
+	struct xrt_space_overseer *xso = ics->server->xso;
+	if (xso->flugelkranz_apply == NULL || update->count > IPC_FLUGELKRANZ_MAX_DEVICES)
+		return XRT_ERROR_INPUT_UNSUPPORTED;
+	struct xrt_device *devices[IPC_FLUGELKRANZ_MAX_DEVICES];
+	for (uint32_t i = 0; i < update->count; i++) {
+		GET_XDEV_OR_RETURN(ics, update->device_ids[i], devices[i]);
+	}
+	return xso->flugelkranz_apply(xso, (const void *)ics, stage, update->count, devices, update->rotations);
+}
diff --git a/src/xrt/ipc/server/ipc_server_per_client_thread.c b/src/xrt/ipc/server/ipc_server_per_client_thread.c
index a322e61d8..256b466c5 100644
--- a/src/xrt/ipc/server/ipc_server_per_client_thread.c
+++ b/src/xrt/ipc/server/ipc_server_per_client_thread.c
@@ -120,6 +120,11 @@ common_shutdown(volatile struct ipc_client_state *ics)
 	 * Clean up various resources.
 	 */
 
+	/* Also clear when the owner crashes or closes its IPC socket. */
+	if (ics->server->xso != NULL && ics->server->xso->flugelkranz_apply != NULL) {
+		ics->server->xso->flugelkranz_apply(ics->server->xso, (const void *)ics, NULL, 0, NULL, NULL);
+	}
+
 	// If the session hasn't been stopped, destroy the compositor.
 	ipc_server_client_destroy_session_and_compositor(ics);
 
