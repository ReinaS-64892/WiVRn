index 875da26af..ea00907e9 100644
--- a/src/xrt/ipc/shared/ipc_protocol.h
+++ b/src/xrt/ipc/shared/ipc_protocol.h
@@ -31,6 +31,15 @@
 #include <sys/types.h>
 
 
+/* Private extension: bounded to fit a single IPC message. */
+#define IPC_FLUGELKRANZ_MAX_DEVICES 32
+struct ipc_flugelkranz_update
+{
+	uint32_t count;
+	uint32_t device_ids[IPC_FLUGELKRANZ_MAX_DEVICES];
+	struct xrt_quat rotations[IPC_FLUGELKRANZ_MAX_DEVICES];
+};
+
 #define IPC_CRED_SIZE 1    // auth not implemented
 #define IPC_BUF_SIZE 2048  // must be >= largest message length in bytes
 #define IPC_MAX_VIEWS 8    // max views we will return configs for
