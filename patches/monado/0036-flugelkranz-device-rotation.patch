+
+mnd_result_t
+mnd_root_flugelkranz_refresh_devices(mnd_root_t *root)
+{
+	CHECK_NOT_NULL(root);
+	/* Publish a complete snapshot only after every info query succeeds. */
+	struct ipc_device_list previous_list = root->device_list;
+	struct ipc_device_info previous_infos[XRT_SYSTEM_MAX_DEVICES];
+	memcpy(previous_infos, root->device_infos, sizeof(previous_infos));
+	mnd_result_t ret = update_device_list_and_infos(root);
+	if (ret != MND_SUCCESS) {
+		root->device_list = previous_list;
+		memcpy(root->device_infos, previous_infos, sizeof(previous_infos));
+	}
+	return ret;
+}
+
+mnd_result_t
+mnd_root_flugelkranz_apply(mnd_root_t *root,
+                           const mnd_pose_t *stage_offset,
+                           uint32_t count,
+                           const mnd_flugelkranz_device_rotation_t *rotations)
+{
+	CHECK_NOT_NULL(root);
+	CHECK_NOT_NULL(stage_offset);
+	if (count > MND_FLUGELKRANZ_MAX_DEVICES || (count > 0 && rotations == NULL))
+		return MND_ERROR_INVALID_VALUE;
+	struct ipc_flugelkranz_update update = {0};
+	update.count = count;
+	for (uint32_t i = 0; i < count; i++) {
+		CHECK_DEVICE_INDEX(rotations[i].device_index);
+		update.device_ids[i] = root->device_list.devices[rotations[i].device_index].id;
+		memcpy(&update.rotations[i], &rotations[i].orientation, sizeof(struct xrt_quat));
+	}
+	xrt_result_t ret =
+	    ipc_call_space_flugelkranz_apply(&root->ipc_c, (const struct xrt_pose *)stage_offset, &update);
+	return ret == XRT_SUCCESS ? MND_SUCCESS : MND_ERROR_OPERATION_FAILED;
+}
diff --git a/src/xrt/targets/libmonado/monado.h b/src/xrt/targets/libmonado/monado.h
index 7cd8b45e9..6deb0a5e1 100644
--- a/src/xrt/targets/libmonado/monado.h
+++ b/src/xrt/targets/libmonado/monado.h
@@ -643,6 +643,39 @@ mnd_root_get_reference_space_offset(mnd_root_t *root, mnd_reference_space_type_t
 mnd_result_t
 mnd_root_set_reference_space_offset(mnd_root_t *root, mnd_reference_space_type_t type, const mnd_pose_t *offset);
 
+/* Private WiVRn extension, version 1. Does not change the upstream ABI version.
+ * Refresh invalidates all previously obtained device indices and property strings.
+ * Re-enumerate and match serials after refreshing; never persist indices. */
+mnd_result_t
+mnd_root_flugelkranz_refresh_devices(mnd_root_t *root);
+
+#define MND_FLUGELKRANZ_MAX_DEVICES 32
+typedef struct mnd_flugelkranz_device_rotation
+{
+	uint32_t device_index;
+	struct
+	{
+		float x, y, z, w;
+	} orientation;
+} mnd_flugelkranz_device_rotation_t;
+
+/* Atomically replace STAGE and the complete set of tracker orientation offsets.
+ * Each quaternion is a unit rotation in Monado ROOT axes, left-multiplied onto
+ * the tracked orientation about that device's position (no position offset).
+ * Physical orientation changes remain visible. Omitted devices are cleared.
+ * Count zero clears all corrections. Corrections are also cleared on disconnect
+ * and device removal. Only one IPC connection may own a nonempty set at a time.
+ * Raw device poses are unchanged; space queries see corrected orientations.
+ * Angular velocity is marked invalid while corrected (no derivative supplied).
+ * Inputs must be finite, normalized, unique and refer to generic trackers.
+ * This is a sampled update, just like set_reference_space_offset. */
+mnd_result_t
+mnd_root_flugelkranz_apply(mnd_root_t *root,
+                           const mnd_pose_t *stage_offset,
+                           uint32_t count,
+                           const mnd_flugelkranz_device_rotation_t *rotations);
+
+
